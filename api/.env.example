# Conexión a MongoDB (contenedor de docker-compose, puerto 27018 del host)
MONGODB_URI=mongodb://127.0.0.1:27018/geest

# Firma de los JWT. En producción usar un valor largo y aleatorio:
#   node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1d

PORT=4000
